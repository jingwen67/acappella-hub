{
  "buildCommand": "npm run build:vercel",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/vercel-worker.mjs",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/recordings/cleanup",
      "schedule": "0 10 * * *"
    }
  ]
}
